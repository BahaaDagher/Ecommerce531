@using Ecommerce531.ViewModels
@model PersonVM
<ul>
    @foreach (var item in Model.Persons)
    {
        <li> Id : @item.Id</li>
        <li> Name : @item.Name</li>
        <li> Address : @item.Address</li>
        <li> Salary : @item.Salary</li>
        <br>
    }

    <h2> count :  @Model.Count</h2>

</ul>